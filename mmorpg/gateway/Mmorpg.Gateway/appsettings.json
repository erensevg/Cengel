{
  "Urls": "http://localhost:5000",
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" } },
  "ReverseProxy": {
    "Routes": {
      "auth":   { "ClusterId": "auth",   "Match": { "Path": "/api/auth/{**rest}" } },
      "game":   { "ClusterId": "game",   "Match": { "Path": "/api/game/{**rest}" } },
      "gamehub":{ "ClusterId": "game",   "Match": { "Path": "/hubs/game/{**rest}" } },
      "social": { "ClusterId": "social", "Match": { "Path": "/api/social/{**rest}" } },
      "chathub":{ "ClusterId": "social", "Match": { "Path": "/hubs/chat/{**rest}" } }
    },
    "Clusters": {
      "auth":   { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "game":   { "Destinations": { "d1": { "Address": "http://localhost:5002/" } } },
      "social": { "Destinations": { "d1": { "Address": "http://localhost:5003/" } } }
    }
  }
}
